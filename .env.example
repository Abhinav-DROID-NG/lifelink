# PostgreSQL
POSTGRES_DB=lifelink
POSTGRES_USER=lifelink
POSTGRES_PASSWORD=lifelink_dev_password

# Backend
PORT=8080
DATABASE_URL=postgres://lifelink:lifelink_dev_password@postgres:5432/lifelink?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
SEED_DEMO=true
LOG_LEVEL=info

# Frontend
VITE_API_BASE_URL=/api